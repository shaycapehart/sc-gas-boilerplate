{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "esnext"],
    "types": ["google-apps-script"],
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "baseUrl": "./",
    "noEmit": true,
    "paths": {
      "@core/*": ["src/core/*"],
      "@features/*": ["src/features/*"]
    },
    "downlevelIteration": true
  },
  "include": ["src/**/*"]
}
